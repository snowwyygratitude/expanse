# Aha runs fully without any of these (demo mode with curated content).
# Add ONE key to switch on live AI personalization. Copy to .env.local.

# Anthropic (default when both keys are present)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional: force a provider when both keys are set (anthropic | openai)
# AI_PROVIDER=anthropic

# Optional: point at a proxy or compatible gateway
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_BASE_URL=https://api.openai.com/v1
